# ============================================================================
# BiblioPlus — variables d'environnement (exemple)
# Copiez ce fichier en ".env" et renseignez vos valeurs. Le .env n'est PAS versionné.
# Convention .NET : "SECTION__CLE" alimente la section de configuration "Section:Cle".
# ============================================================================

# --- Envoi d'e-mails (SMTP Gmail) ---
# Passez EMAIL__ENABLED à true une fois vos identifiants renseignés.
# Tant que false : les e-mails sont seulement journalisés (aucun envoi réel).
EMAIL__ENABLED=false

# Serveur SMTP de Gmail
EMAIL__HOST=smtp.gmail.com
EMAIL__PORT=587
EMAIL__ENABLESSL=true

# Compte expéditeur.
# IMPORTANT (Gmail) : utilisez un "mot de passe d'application" (16 caractères),
# pas votre mot de passe habituel. Cf. https://myaccount.google.com/apppasswords
EMAIL__USER=votre-adresse@gmail.com
EMAIL__PASSWORD=votre-mot-de-passe-application
EMAIL__FROM=BiblioPlus <votre-adresse@gmail.com>
