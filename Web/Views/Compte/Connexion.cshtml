@model Web.Models.ConnexionViewModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@{
    ViewData["Title"] = "Connexion";
    Layout = "_LayoutAuth";
}

<h1 class="auth__title">Connexion</h1>
<p class="auth__sub">Accédez à votre espace BiblioPlus.</p>

<form asp-controller="Compte" asp-action="Connexion" method="post">
    <input type="hidden" asp-for="ReturnUrl" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" autocomplete="username" autofocus />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="MotDePasse" class="form-label"></label>
        <input asp-for="MotDePasse" class="form-control" autocomplete="current-password" />
        <span asp-validation-for="MotDePasse" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary w-100">Se connecter</button>
</form>

<p class="auth__foot">
    Pas encore de compte ?
    <a asp-controller="Compte" asp-action="Inscription">Créer un compte adhérent</a>
</p>

@if (Env.IsDevelopment())
{
    <div class="auth__demo">
        <div class="auth__demo-head">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
            Connexion rapide (démo)
        </div>
        <div class="auth__demo-grid">
            <form asp-controller="Compte" asp-action="ConnexionRapide" method="post">
                <input type="hidden" name="role" value="Admin" />
                <button type="submit" class="btn btn-outline-secondary w-100">
                    Admin
                    <span class="auth__demo-id">admin@biblioplus.local</span>
                </button>
            </form>
            <form asp-controller="Compte" asp-action="ConnexionRapide" method="post">
                <input type="hidden" name="role" value="Adherent" />
                <button type="submit" class="btn btn-outline-secondary w-100">
                    Adhérent
                    <span class="auth__demo-id">marie@biblioplus.local</span>
                </button>
            </form>
        </div>
        <p class="auth__demo-note">Un clic vous connecte sans saisie · disponible uniquement en développement.</p>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
