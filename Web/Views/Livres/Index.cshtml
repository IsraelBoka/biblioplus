@model IEnumerable<Web.Models.LivreViewModel>
@{
    ViewData["Title"] = "Livres";
}

<div class="page-head">
    <div>
        <h1>Livres</h1>
        <p class="page-head__sub">Catalogue des œuvres, classées par catégorie.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Nouveau livre
    </a>
</div>

@if (TempData["Message"] is not null)
{
    <div class="alert alert-success mb-3">@TempData["Message"]</div>
}
@if (TempData["Erreur"] is not null)
{
    <div class="alert alert-danger mb-3">@TempData["Erreur"]</div>
}

@if (Model.Any())
{
    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr>
                    <th>Titre</th>
                    <th>Auteur</th>
                    <th>Catégorie</th>
                    <th>ISBN</th>
                    <th>Exemplaires</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><strong>@item.Titre</strong></td>
                    <td>@item.Auteur</td>
                    <td><span class="badge bg-info">@item.CategorieLibelle</span></td>
                    <td class="text-muted">@item.Isbn</td>
                    <td>@item.NombreExemplaires</td>
                    <td>
                        <span class="row-actions">
                            <a asp-action="Details" asp-route-id="@item.Id">Détails</a>
                            <a asp-action="Edit" asp-route-id="@item.Id">Modifier</a>
                            <a asp-action="Delete" asp-route-id="@item.Id">Supprimer</a>
                        </span>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="table-wrap">
        <div class="empty">
            <p>Aucun livre pour le moment.</p>
            <a class="btn btn-primary btn-sm" asp-action="Create">Ajouter un livre</a>
        </div>
    </div>
}
