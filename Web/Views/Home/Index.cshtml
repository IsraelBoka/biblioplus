@{
    ViewData["Title"] = "Accueil";
}

<div class="text-center">
    <h1 class="display-4">BiblioPlus</h1>
    <p class="lead">Gestion d'une bibliothèque : exemplaires, emprunts, retours et pénalités.</p>
</div>

<div class="row mt-4">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Référentiel — Catégories de livres</h5>
                <p class="card-text">CRUD complet avec suppression logique (partie MVC).</p>
                <a class="btn btn-primary" asp-controller="CategoriesLivres" asp-action="Index">Ouvrir le référentiel</a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">API REST</h5>
                <p class="card-text">Emprunts, retours, disponibilité et pénalités — documentés via OpenAPI.</p>
                <a class="btn btn-outline-secondary" href="http://localhost:5188/swagger" target="_blank">Swagger de l'API</a>
            </div>
        </div>
    </div>
</div>
