@model Web.Models.EmpruntCreateViewModel
@{
    ViewData["Title"] = "Nouvel emprunt";
}

<div class="page-head">
    <div>
        <h1>Nouvel emprunt</h1>
        <p class="page-head__sub">
            L'échéance est calculée automatiquement selon la catégorie du livre.
            Les règles d'éligibilité (adhérent actif, pénalités, quota, disponibilité) sont vérifiées à la validation.
        </p>
    </div>
</div>

<div class="form-panel">
        <form asp-action="Create">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="AdherentId" class="form-label"></label>
                <select asp-for="AdherentId" class="form-select"
                        asp-items="@(ViewBag.Adherents as SelectList)">
                    <option value="">-- Choisir un adhérent --</option>
                </select>
                <span asp-validation-for="AdherentId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ExemplaireId" class="form-label"></label>
                <select asp-for="ExemplaireId" class="form-select"
                        asp-items="@(ViewBag.Exemplaires as SelectList)">
                    <option value="">-- Choisir un exemplaire disponible --</option>
                </select>
                <span asp-validation-for="ExemplaireId" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Enregistrer l'emprunt</button>
            <a class="btn btn-secondary" asp-action="Index">Annuler</a>
        </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
