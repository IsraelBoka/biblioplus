@model Web.Models.ExemplaireViewModel
@{
    ViewData["Title"] = "Détails de l'exemplaire";
}

<h1>Détails de l'exemplaire</h1>

<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.CodeBarres)</dt>
    <dd class="col-sm-9">@Model.CodeBarres</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.LivreTitre)</dt>
    <dd class="col-sm-9">@Model.LivreTitre</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Etat)</dt>
    <dd class="col-sm-9">@Model.Etat</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Statut)</dt>
    <dd class="col-sm-9">@Model.Statut</dd>
</dl>

<a class="btn btn-secondary" asp-action="Index">Retour</a>
<a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Modifier</a>
