@model Web.Models.CategorieLivreViewModel
@{
    ViewData["Title"] = "Nouvelle catégorie";
}

<div class="page-head"><div><h1>Nouvelle catégorie</h1></div></div>

<div class="form-panel">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Code" class="form-label"></label>
                <input asp-for="Code" class="form-control" />
                <span asp-validation-for="Code" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Libelle" class="form-label"></label>
                <input asp-for="Libelle" class="form-control" />
                <span asp-validation-for="Libelle" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DureeMaxJours" class="form-label"></label>
                <input asp-for="DureeMaxJours" class="form-control" />
                <span asp-validation-for="DureeMaxJours" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="PenaliteParJour" class="form-label"></label>
                <input asp-for="PenaliteParJour" class="form-control" />
                <span asp-validation-for="PenaliteParJour" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Créer</button>
            <a class="btn btn-secondary" asp-action="Index">Annuler</a>
        </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
