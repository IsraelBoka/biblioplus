@model Web.Models.AdherentViewModel
@{
    ViewData["Title"] = "Détails de l'adhérent";
}

<h1>Détails de l'adhérent</h1>

<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Numero)</dt>
    <dd class="col-sm-9">@Model.Numero</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Nom)</dt>
    <dd class="col-sm-9">@Model.Nom</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Telephone)</dt>
    <dd class="col-sm-9">@Model.Telephone</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.DateAdhesion)</dt>
    <dd class="col-sm-9">@Model.DateAdhesion.ToString("dd/MM/yyyy")</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Actif)</dt>
    <dd class="col-sm-9">@(Model.Actif ? "Oui" : "Non")</dd>
</dl>

<a class="btn btn-secondary" asp-action="Index">Retour</a>
<a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Modifier</a>
